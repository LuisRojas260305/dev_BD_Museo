# Puerto del servidor
PORT=3000

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
DB_NAME=test_bodega_museo

# JWT (generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=cambiar_por_un_secreto_seguro

# Microservicios — Internal API Key para service-to-service
INTERNAL_API_KEY=cambiar_por_clave_interna_segura

# Cassandra (auditoría)
CASSANDRA_URL=http://localhost:3002/api/auditoria

# MongoDB (catálogo público)
CATALOG_URL=http://localhost:3001/api/catalog
